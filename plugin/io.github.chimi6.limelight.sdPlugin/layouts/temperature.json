{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
	"id": "limelight-temperature",
	"items": [
		{
			"key": "title",
			"type": "text",
			"rect": [16, 10, 136, 24],
			"font": { "size": 16, "weight": 600 },
			"alignment": "left"
		},
		{
			"key": "icon",
			"type": "pixmap",
			"rect": [16, 40, 48, 48]
		},
		{
			"key": "value",
			"type": "text",
			"rect": [76, 40, 108, 32],
			"font": { "size": 24, "weight": 600 },
			"alignment": "right"
		},
		{
			"key": "indicator",
			"type": "gbar",
			"rect": [76, 74, 108, 20],
			"value": 4500,
			"subtype": 4,
			"bar_h": 12,
			"border_w": 0,
			"range": { "min": 2900, "max": 7000 },
			"bar_bg_c": "0:#6AA8FF,0.5:#EAF2FF,1:#F4B37A"
		}
	]
}
